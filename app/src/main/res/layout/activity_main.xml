<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FaMiLa Print"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0B1B46" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="XP-P328B Bluetooth etiket yazdırma"
            android:textSize="15sp"
            android:textColor="#667085" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Yazıcı"
            android:textStyle="bold"
            android:textColor="#0B1B46" />

        <Spinner
            android:id="@+id/printerSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <Button
            android:id="@+id/openBluetoothButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bluetooth Ayarlarını Aç" />

        <EditText
            android:id="@+id/brandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Marka"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/productInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Ürün adı"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/barcodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Barkod"
            android:inputType="text"
            android:padding="14dp"
            android:background="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/widthInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Genişlik mm"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/heightInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Yükseklik mm"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/countInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Adet"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FFFFFF" />

        <Button
            android:id="@+id/printButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="Etiketi Yazdır"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B1B46" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:text="Hazır"
            android:textColor="#344054"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
